clear all
set more off
cd "A:\UHH\Seminar\Exhibits\GSY_Germany_Replication"

*******************************************************
* Step 1. Prepare the Germany security sample
*******************************************************
use "comp_global_daily.dta", clear
keep if fic == "DEU"
keep if tpci == "0"
keep if !missing(gsector) & prccd > 0
keep fic gvkey iid datadate conm isin sedol exchg secstat ///
     conml ggroup gind gsector gsubind stko ajexdi cshoc ///
     cshtrd curcdd div divd prccd prchd prcld tpci trfd
sort gvkey iid datadate
compress
save "germany_prepared.dta", replace

*******************************************************
* Step 2. Convert DEM to EUR and record currency changes
*******************************************************
use "germany_prepared.dta", clear
gen fx_eur = .
replace fx_eur = 1 if curcdd == "EUR"
replace fx_eur = 1/1.95583 if curcdd == "DEM"
keep if !missing(fx_eur)

sort gvkey iid datadate
by gvkey iid: gen previous_currency = curcdd[_n-1]
gen currency_transition = previous_currency != curcdd ///
    if !missing(previous_currency)
count if currency_transition == 1
save "germany_currency_clean.dta", replace

*******************************************************
* Step 3. Construct adjusted total-return prices
*******************************************************
use "germany_currency_clean.dta", clear
gen tr_price_eur = (prccd * fx_eur / ajexdi) * trfd ///
    if prccd > 0 & ajexdi > 0 & fx_eur > 0 & trfd > 0
sort gvkey iid datadate
by gvkey iid: gen tr_price_lag = tr_price_eur[_n-1]
gen ret_daily = tr_price_eur / tr_price_lag - 1 if tr_price_lag > 0
save "germany_returns_raw.dta", replace

*******************************************************
* Step 4. Clean obvious daily return errors
*******************************************************
use "germany_returns_raw.dta", clear
sort gvkey iid datadate
by gvkey iid: gen tr_price_lag2 = tr_price_eur[_n-2]
gen ret_2day = tr_price_eur / tr_price_lag2 - 1 if tr_price_lag2 > 0
gen bad_reversal = 0
replace bad_reversal = 1 if (ret_daily > 1 | ret_daily[_n-1] > 1) & ///
    ret_2day < .20 & gvkey == gvkey[_n-1] & iid == iid[_n-1]
gen bad_extreme = ret_daily > 2 if !missing(ret_daily)
gen bad_return = bad_reversal == 1 | bad_extreme == 1
replace ret_daily = . if bad_return == 1
drop tr_price_lag tr_price_lag2 ret_2day bad_reversal bad_extreme bad_return ///
     previous_currency currency_transition
save "germany_daily_clean.dta", replace

*******************************************************
* Step 5. Construct monthly security returns
*******************************************************
use "germany_daily_clean.dta", clear
gen mdate = mofd(datadate)
format mdate %tm
sort gvkey iid mdate datadate
by gvkey iid mdate: gen month_last = datadate == datadate[_N]
keep if month_last
sort gvkey iid mdate
by gvkey iid: gen tr_price_month_lag = tr_price_eur[_n-1]
gen ret_monthly = tr_price_eur / tr_price_month_lag - 1 ///
    if tr_price_month_lag > 0 & mdate == mdate[_n-1] + 1
save "germany_monthly_security.dta", replace

*******************************************************
* Step 6. Construct value-weighted industry portfolios
*******************************************************
use "germany_monthly_security.dta", clear
sort gvkey iid mdate
gen mktcap_eur = prccd * fx_eur * cshoc ///
    if prccd > 0 & fx_eur > 0 & cshoc > 0
by gvkey iid: gen mktcap_lag = mktcap_eur[_n-1]
keep if !missing(gsector, ret_monthly) & mktcap_lag > 0
bysort mdate gsector: egen industry_mktcap = total(mktcap_lag)
gen industry_weight = mktcap_lag / industry_mktcap
gen weighted_industry_return = industry_weight * ret_monthly
bysort mdate gsector: egen industry_return = total(weighted_industry_return)
bysort mdate: egen market_mktcap = total(mktcap_lag)
gen market_weight = mktcap_lag / market_mktcap
gen weighted_market_return = market_weight * ret_monthly
bysort mdate: egen market_return = total(weighted_market_return)
gen net_market_return = industry_return - market_return
keep gsector mdate industry_return market_return net_market_return
duplicates drop
sort gsector mdate
save "germany_industry_monthly.dta", replace

*******************************************************
* Step 7. Identify discrete GSY run-up episodes
*******************************************************
use "germany_industry_monthly.dta", clear
sort gsector mdate
encode gsector, gen(sector_id)
tsset sector_id mdate, monthly
gen log_raw = ln(1 + industry_return)
gen log_net = ln(1 + net_market_return)
by sector_id (mdate): gen cumlog_raw = sum(log_raw)
by sector_id (mdate): gen cumlog_net = sum(log_net)
gen raw_24 = exp(cumlog_raw - L24.cumlog_raw) - 1 ///
    if mdate == L24.mdate + 24
gen net_24 = exp(cumlog_net - L24.cumlog_net) - 1 ///
    if mdate == L24.mdate + 24
gen raw_60 = exp(cumlog_raw - L60.cumlog_raw) - 1 ///
    if mdate == L60.mdate + 60

* The signal is lagged one month so only prior information is used.
gen runup_raw24 = L1.raw_24
gen runup_net24 = L1.net_24
gen runup_raw60 = L1.raw_60

foreach X in 50 75 100 125 150 {
    local x = `X'/100
    gen qualify`X' = !missing(runup_raw24, runup_net24, runup_raw60) & ///
        runup_raw24 >= `x' & runup_net24 >= `x' & runup_raw60 >= .50
    gen prior_event`X' = 0
    forvalues L = 1/24 {
        replace prior_event`X' = 1 if L`L'.qualify`X' == 1
    }
    gen runup`X' = qualify`X' == 1 & prior_event`X' == 0
}
save "germany_runup_monthly.dta", replace

*******************************************************
* Step 8. Forward outcomes and maximum drawdowns
*******************************************************
use "germany_runup_monthly.dta", clear
sort sector_id mdate
tsset sector_id mdate, monthly

gen byte complete12 = 1
forvalues j = 1/12 {
    replace complete12 = 0 if missing(F`j'.mdate) | F`j'.mdate != mdate + `j'
}
gen byte complete24 = 1
forvalues j = 1/24 {
    replace complete24 = 0 if missing(F`j'.mdate) | F`j'.mdate != mdate + `j'
}
gen fwd12_raw = exp(F12.cumlog_raw - cumlog_raw) - 1 if complete12
gen fwd24_raw = exp(F24.cumlog_raw - cumlog_raw) - 1 if complete24
gen fwd12_net = exp(F12.cumlog_net - cumlog_net) - 1 if complete12
gen fwd24_net = exp(F24.cumlog_net - cumlog_net) - 1 if complete24

* Include event month 0 as the initial possible peak.
gen maxdd_raw24 = 0
gen maxdd_net24 = 0
forvalues j = 1/24 {
    gen wealth_raw = exp(F`j'.cumlog_raw - cumlog_raw) if complete24
    gen wealth_net = exp(F`j'.cumlog_net - cumlog_net) if complete24
    gen peak_raw = 1 if complete24
    gen peak_net = 1 if complete24
    forvalues k = 1/`j' {
        replace peak_raw = max(peak_raw, exp(F`k'.cumlog_raw - cumlog_raw)) ///
            if complete24 & !missing(wealth_raw)
        replace peak_net = max(peak_net, exp(F`k'.cumlog_net - cumlog_net)) ///
            if complete24 & !missing(wealth_net)
    }
    replace maxdd_raw24 = min(maxdd_raw24, wealth_raw/peak_raw - 1) ///
        if complete24 & !missing(wealth_raw, peak_raw)
    replace maxdd_net24 = min(maxdd_net24, wealth_net/peak_net - 1) ///
        if complete24 & !missing(wealth_net, peak_net)
    drop wealth_raw wealth_net peak_raw peak_net
}
gen crash_raw40 = maxdd_raw24 <= -.40 if complete24
gen crash_net40 = maxdd_net24 <= -.40 if complete24
save "germany_runup_outcomes.dta", replace

*******************************************************
* Step 9. Pre-run-up annualized volatility
*******************************************************
use "germany_daily_clean.dta", clear
gen mdate = mofd(datadate)
format mdate %tm
gen mktcap_eur = prccd * fx_eur * cshoc ///
    if prccd > 0 & fx_eur > 0 & cshoc > 0
sort gvkey iid datadate
by gvkey iid: gen mktcap_lag = mktcap_eur[_n-1]
keep if !missing(gsector, ret_daily) & mktcap_lag > 0
bysort datadate gsector: egen sector_mktcap = total(mktcap_lag)
gen daily_weight = mktcap_lag / sector_mktcap
gen weighted_daily_ret = daily_weight * ret_daily
bysort datadate gsector: egen industry_daily_ret = total(weighted_daily_ret)
keep datadate mdate gsector industry_daily_ret
duplicates drop
sort gsector datadate
gen n_daily = !missing(industry_daily_ret)
gen sum_daily = cond(missing(industry_daily_ret),0,industry_daily_ret)
gen sq_daily = cond(missing(industry_daily_ret),0,industry_daily_ret^2)
by gsector: gen cum_n = sum(n_daily)
by gsector: gen cum_sum = sum(sum_daily)
by gsector: gen cum_sq = sum(sq_daily)
bysort gsector mdate (datadate): gen month_last = _n == _N
keep if month_last
encode gsector, gen(sector_id)
tsset sector_id mdate, monthly
gen n12 = L1.cum_n - L13.cum_n
gen sum12 = L1.cum_sum - L13.cum_sum
gen sq12 = L1.cum_sq - L13.cum_sq
gen volatility_annual = sqrt((sq12 - sum12^2/n12)/(n12-1))*sqrt(252) ///
    if n12 > 1 & mdate == L1.mdate + 1 & mdate == L13.mdate + 13
keep gsector mdate volatility_annual
save "germany_industry_volatility.dta", replace

*******************************************************
* Step 10. Create the regression-only analysis file
*******************************************************
use "germany_runup_outcomes.dta", clear
merge 1:1 gsector mdate using "germany_industry_volatility.dta"
keep if _merge == 3
drop _merge
save "germany_gsy_analysis.dta", replace

*******************************************************
* Step 11. Main threshold exhibit
*******************************************************
use "germany_runup_outcomes.dta", clear
tempfile results
postfile results threshold episodes raw_crashes raw_crash_prob ///
    net_crashes net_crash_prob mean_drawdown mean_fwd12 mean_fwd24 using `results', replace
foreach X in 50 75 100 125 150 {
    quietly count if runup`X' == 1
    local N = r(N)
    quietly count if runup`X' == 1 & crash_raw40 == 1
    local rawN = r(N)
    quietly count if runup`X' == 1 & crash_net40 == 1
    local netN = r(N)
    quietly summarize maxdd_raw24 if runup`X' == 1
    local dd = r(mean)
    quietly summarize fwd12_raw if runup`X' == 1
    local r12 = r(mean)
    quietly summarize fwd24_raw if runup`X' == 1
    local r24 = r(mean)
    post results (`X') (`N') (`rawN') (`rawN'/`N') (`netN') (`netN'/`N') (`dd') (`r12') (`r24')
}
postclose results
use `results', clear
gen raw_crash_pct = round(100*raw_crash_prob,.1)
gen net_crash_pct = round(100*net_crash_prob,.1)
gen fwd12_raw_pct = round(100*mean_fwd12,.1)
gen fwd24_raw_pct = round(100*mean_fwd24,.1)
gen drawdown_pct = round(100*mean_drawdown,.1)
label variable threshold "Pick-up threshold (%)"
label variable episodes "Number of run-ups identified"
label variable raw_crash_pct "Raw crashes (%)"
label variable net_crash_pct "Net-market crashes (%)"
label variable fwd12_raw_pct "12M raw return (%)"
label variable fwd24_raw_pct "24M raw return (%)"
label variable drawdown_pct "24M drawdown (%)"
order threshold episodes fwd12_raw_pct fwd24_raw_pct raw_crash_pct net_crash_pct drawdown_pct
export excel using "germany_crash_results.xlsx", firstrow(varlabels) replace

*******************************************************
* Step 12. Formal crash-probability test
*******************************************************
use "germany_runup_outcomes.dta", clear
quietly count if complete24 == 1
local N_all = r(N)
quietly count if complete24 == 1 & crash_raw40 == 1
local C_all = r(N)
local P_all = `C_all'/`N_all'
quietly count if runup100 == 1
local N_cond = r(N)
quietly count if runup100 == 1 & crash_raw40 == 1
local C_cond = r(N)
local P_cond = `C_cond'/`N_cond'
quietly count if complete24 == 1 & runup100 == 0
local N_non = r(N)
quietly count if complete24 == 1 & runup100 == 0 & crash_raw40 == 1
local C_non = r(N)
local P_non = `C_non'/`N_non'
local P_pool = (`C_all'+`C_cond')/(`N_all'+`N_cond')
local SE = sqrt(`P_pool'*(1-`P_pool')*(1/`N_all'+1/`N_cond'))
local Z = (`P_cond'-`P_all')/`SE'
local pvalue = 2*normal(-abs(`Z'))
local P_pool2 = (`C_cond'+`C_non')/(`N_cond'+`N_non')
local SE2 = sqrt(`P_pool2'*(1-`P_pool2')*(1/`N_cond'+1/`N_non'))
local Z2 = (`P_cond'-`P_non')/`SE2'
local pvalue2 = 2*normal(-abs(`Z2'))
tempfile testresults
postfile testresults str30 comparison N crashes probability difference z pvalue using `testresults', replace
post testresults ("Unconditional") (`N_all') (`C_all') (`P_all') (.) (.) (.)
post testresults ("100% run-up") (`N_cond') (`C_cond') (`P_cond') (`P_cond'-`P_all') (`Z') (`pvalue')
post testresults ("Non-100% months") (`N_non') (`C_non') (`P_non') (`P_cond'-`P_non') (`Z2') (`pvalue2')
postclose testresults
use `testresults', clear
gen probability_pct = round(100*probability,.1)
gen difference_pct = round(100*difference,.1)
label variable comparison "Comparison"
label variable N "Observations"
label variable crashes "Crashes"
label variable probability_pct "Crash probability (%)"
label variable difference_pct "Difference (percentage points)"
label variable z "z statistic"
label variable pvalue "p-value"
keep comparison N crashes probability_pct difference_pct z pvalue
export excel using "germany_crash_test.xlsx", firstrow(varlabels) replace

*******************************************************
* Step 13. Footnote-15-style regressions
*******************************************************
use "germany_gsy_analysis.dta", clear
gen calyear = year(dofm(mdate))
foreach X in 50 75 100 125 150 {
    local x = `X'/100
    gen rup_raw`X' = runup_raw24 > `x' if !missing(runup_raw24)
    gen rup_net`X' = runup_net24 > `x' if !missing(runup_net24)
}
tempfile regresults
postfile regresults str5 returntype threshold str8 volatility N ///
    b_runup se_runup p_runup b_vol se_vol p_vol r2 using `regresults', replace
foreach type in raw net {
    foreach X in 50 75 100 125 150 {
        quietly regress crash_raw40 rup_`type'`X' if complete24 == 1, vce(cluster calyear)
        local b = _b[rup_`type'`X']
        local se = _se[rup_`type'`X']
        local p = 2*ttail(e(df_r),abs(`b'/`se'))
        post regresults ("`type'") (`X') ("No") (e(N)) (`b') (`se') (`p') (.) (.) (.) (e(r2))
        quietly regress crash_raw40 rup_`type'`X' volatility_annual ///
            if complete24 == 1 & !missing(volatility_annual), vce(cluster calyear)
        local b = _b[rup_`type'`X']
        local se = _se[rup_`type'`X']
        local p = 2*ttail(e(df_r),abs(`b'/`se'))
        local bv = _b[volatility_annual]
        local sv = _se[volatility_annual]
        local pv = 2*ttail(e(df_r),abs(`bv'/`sv'))
        post regresults ("`type'") (`X') ("Yes") (e(N)) (`b') (`se') (`p') (`bv') (`sv') (`pv') (e(r2))
    }
}
postclose regresults
use `regresults', clear
foreach v in b_runup se_runup p_runup b_vol se_vol p_vol r2 {
    replace `v' = round(`v',.0001)
}
label variable returntype "Return type"
label variable threshold "Threshold (%)"
label variable volatility "Volatility control"
label variable N "Observations"
label variable b_runup "Run-up coefficient"
label variable se_runup "Run-up standard error"
label variable p_runup "Run-up p-value"
label variable b_vol "Volatility coefficient"
label variable se_vol "Volatility standard error"
label variable p_vol "Volatility p-value"
label variable r2 "R-squared"
export excel using "germany_footnote15_regressions.xlsx", firstrow(varlabels) replace

